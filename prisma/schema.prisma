datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Rol {
  id          String    @id @default(uuid())
  nombre      String    @unique // ej: SUPER_ADMIN, SEDE_ADMIN, VISUALIZADOR, TRABAJADOR
  descripcion String?
  permisos    String[]  @default([])
  esFijo      Boolean   @default(false)
  creadoEn    DateTime  @default(now())
  usuarios    Usuario[]
}

enum TipoLicencia {
  ENFERMEDAD_COMUN
  ACCIDENTE_COMUN
  MATERNIDAD
  PATERNIDAD
  LEY_30012
}

enum OrigenCertificado {
  ESSALUD_CITT
  PARTICULAR
  PARTICULAR_PERDIDO
}

model Usuario {
  id              String         @id @default(uuid())
  dni             String         @unique
  nombres         String
  apellidos       String
  passwordHash    String
  
  rolId           String
  rol             Rol            @relation(fields: [rolId], references: [id])
  permisosExtra   String[]       @default([]) // Permisos excepcionales
  
  microredId      Int?
  microred        Microred?      @relation(fields: [microredId], references: [id])
  activo          Boolean        @default(true)
  creadoEn        DateTime       @default(now())
  
  licenciasRegistradas Licencia[]
  auditorias           Auditoria[]
}

model Microred {
  id               Int               @id @default(autoincrement())
  nombre           String            @unique
  establecimientos Establecimiento[]
  usuarios         Usuario[]
}

model Establecimiento {
  id           Int           @id @default(autoincrement())
  codigoRenaes String?       @unique
  nombre       String
  microredId   Int
  microred     Microred      @relation(fields: [microredId], references: [id])
  trabajadores Trabajador[]
}

model Trabajador {
  id                String          @id @default(uuid())
  dni               String          @unique
  nombres           String
  apellidos         String
  cargo             String
  condicionLaboral  String
  establecimientoId Int
  establecimiento   Establecimiento @relation(fields: [establecimientoId], references: [id])
  licencias         Licencia[]
}

model Licencia {
  id                String            @id @default(uuid())
  trabajadorId      String
  trabajador        Trabajador        @relation(fields: [trabajadorId], references: [id])
  tipoLicencia      TipoLicencia      @default(ENFERMEDAD_COMUN)
  origen            OrigenCertificado
  numeroCertificado String
  fechaInicio       DateTime
  fechaFin          DateTime
  diasOtorgados     Int
  anioEjercicio     Int
  mesEjercicio      Int
  
  archivoRuta       String?
  medico            String?
  colegiatura       String?
  diagnostico       String?
  
  registradoPorId   String?
  registradoPor     Usuario?          @relation(fields: [registradoPorId], references: [id])
  
  creadoEn          DateTime          @default(now())
}

model Auditoria {
  id        String   @id @default(uuid())
  usuarioId String?  
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  accion    String   // CREAR, EDITAR, ELIMINAR
  modulo    String   // LICENCIA, USUARIO
  entidadId String?
  detalles  String   @db.Text
  fecha     DateTime @default(now())
}

